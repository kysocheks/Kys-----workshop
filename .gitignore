# Чужие библиотеки. Восстанавливаются командой npm install из package-lock.json,
# поэтому в репозитории им делать нечего: 19 тысяч файлов и почти 400 МБ.
node_modules/

# Сборка Next. Пересобирается из исходников, в репозитории не нужна.
.next/
out/
build/
dist/

# Служебное от съёмки кадров.
.shoot-profile/

# Окружение и ключи. Не должны попадать в репозиторий никогда.
.env
.env.local
.env*.local

# Логи и мусор системы.
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Кэш инструментов.
*.tsbuildinfo
next-env.d.ts
.vercel
